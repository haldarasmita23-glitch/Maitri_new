# ───────────────────────────────────────────────
# Maitri — .gitignore
# ───────────────────────────────────────────────

# ─── Maven Build Output ──────────────────────
target/
*.class
*.jar
*.war
*.ear

# ─── Environment-Specific Config (NEVER COMMIT SENSITIVE LOCAL PROPS) ──
# application-local.properties contains raw local passwords/connection strings.
backend/src/main/resources/application-local.properties

# ─── Environment Variable Files ──────────────
.env
.env.local
.env.production
# (Keep .env.example — it documents required variables without secrets)

# ─── IDE / Editor ────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.classpath
.project
.settings/
*.factorypath

# ─── OS Files ────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Logs ────────────────────────────────────
*.log
logs/
log/

# ─── Node (in case frontend tooling is added later) ──
node_modules/
npm-debug.log*
yarn-debug.log*

# ─── Spring Boot DevTools ────────────────────
.spring-boot-devtools.properties

# ─── AWS / Cloud Credentials ─────────────────
# Never commit cloud credentials or access keys
*.pem
*.key
aws-credentials
.aws/

# ─── Uploaded Files (will go to S3 in production) ──
uploads/

# ─── Compiled Frontend Assets (future) ───────
dist/
build/
