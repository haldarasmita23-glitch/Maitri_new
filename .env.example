# Maitri — Required Environment Variables
#
# This file documents all environment variables used by the application.
# It is SAFE to commit this file because it contains NO real values.
#
# HOW TO USE:
#   For local development:
#     Copy backend/src/main/resources/application-local.properties.example
#     to application-local.properties and fill in your values.
#
#   For production:
#     Set these as environment variables on the server,
#     or use AWS Secrets Manager / Parameter Store.
#
# ─────────────────────────────────────────────────────

# ─── MongoDB ──────────────────────────────────────────
# Local dev default: mongodb://localhost:27017/maitri_db
# Production: your AWS MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/maitri_db

# ─── JWT Authentication (Phase 3) ─────────────────────
# MUST be a long, random, secret string in production.
# Generate one: openssl rand -hex 64
JWT_SECRET=change-this-to-a-very-long-random-secret-key-in-production

# JWT token expiry in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# ─── Admin Seeding (Phase 6) ──────────────────────────
# The initial admin account credentials.
# Only used on first startup when no admin exists.
ADMIN_EMAIL=admin@maitri.in
ADMIN_PASSWORD=change-this-strong-admin-password

# ─── Spring Profile ───────────────────────────────────
# Set to 'local' for development, 'prod' for production
SPRING_PROFILES_ACTIVE=local

# ─── CORS (Production Only) ───────────────────────────
# Comma-separated list of allowed frontend origins
# Example: https://maitri.in,https://www.maitri.in
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
