# ─────────────────────────────────────────────────────────────────
# Maitri Backend — PRODUCTION Configuration (EXAMPLE / TEMPLATE)
# File: application-prod.properties.example
#
# ✅  THIS FILE IS COMMITTED to Git — it contains NO real secrets.
#
# HOW TO USE:
#   1. Copy this file: application-prod.properties.example
#   2. Rename the copy to: application-prod.properties
#   3. The renamed file is gitignored — safe to put real values in it.
#   4. Adjust values as needed for your production setup.
# ─────────────────────────────────────────────────────────────────

# ─── MongoDB ──────────────────────────────────────────────────────
# Production MongoDB Atlas connection string.
# Set via MONGODB_URI environment variable in production.
# Example: mongodb+srv://user:password@cluster.mongodb.net/maitri_db
spring.data.mongodb.uri=${MONGODB_URI}

# ─── JWT Configuration (Phase 3) ──────────────────────────────────
# Secret key used to sign JWT tokens. Must be at least 32 characters (256 bits).
# For production, MUST be set via JWT_SECRET environment variable.
# NEVER hardcode a real secret here.
jwt.secret=${JWT_SECRET}

# JWT token expiry in milliseconds (default: 86400000 = 24 hours)
jwt.expiration.ms=${JWT_EXPIRATION_MS:86400000}

# ─── CORS (Production) ────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: https://maitri.in,https://www.maitri.in
# Set via CORS_ALLOWED_ORIGINS environment variable in production.
cors.allowed.origins=${CORS_ALLOWED_ORIGINS}

# ─── Initial Admin Seeding (Phase 3) ─────────────────────────────
# Used by DataSeeder to create the first admin account on startup.
# Only used if no admin exists. Set via environment variables in production.
# NEVER hardcode real credentials here.
admin.initial.email=${ADMIN_INITIAL_EMAIL}
admin.initial.password=${ADMIN_INITIAL_PASSWORD}
admin.initial.name=${ADMIN_INITIAL_NAME}

# ─── Spring Profile ───────────────────────────────────────────────
spring.profiles.active=prod

# ─── Logging (Production) ─────────────────────────────────────────
logging.level.com.maitri=INFO
logging.level.org.springframework.data.mongodb=WARN
logging.level.org.springframework.security=WARN